{
  "expo": {
    "name": "Orbita",
    "slug": "orbita",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbita",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0D",
    "ios": {
      "bundleIdentifier": "com.demonity.orbita",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "CFBundleDisplayName": "Órbita",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.demonity.orbita",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Órbita usa suas fotos para anexar a notas, comprovantes e à foto de perfil.",
          "cameraPermission": "O Órbita usa a câmera para fotografar comprovantes e anexar fotos às notas.",
          "microphonePermission": false
        }
      ],
      "expo-app-intents",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.demonity.orbita.widgets",
          "groupIdentifier": "group.com.demonity.orbita",
          "widgets": [
            {
              "name": "SaldoWidget",
              "displayName": "Saldo",
              "description": "Seu saldo atual e o resultado do mês.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryCircular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}