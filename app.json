{
  "expo": {
    "name": "Orbita",
    "slug": "orbita",
    "version": "0.9.2",
    "orientation": "portrait",
    "icon": "./assets/icons/primary.png",
    "scheme": "orbita",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0D",
    "ios": {
      "bundleIdentifier": "com.demonity.orbita",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icons/primary.png",
        "dark": "./assets/icons/primary-dark.png",
        "tinted": "./assets/icons/primary-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Órbita",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "financy"
        ]
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090B",
          "image": "./assets/icons/primary-dark.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Órbita usa suas fotos para anexar a notas, comprovantes e à foto de perfil.",
          "cameraPermission": "O Órbita usa a câmera para fotografar comprovantes e anexar fotos às notas.",
          "microphonePermission": false
        }
      ],
      "expo-app-intents",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.demonity.orbita.widgets",
          "groupIdentifier": "group.com.demonity.orbita",
          "widgets": [
            {
              "name": "SaldoWidget",
              "displayName": "Saldo",
              "description": "Seu saldo atual e o resultado do mês.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryCircular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "GrafiteAmbar",
            "ios": "./assets/icons/GrafiteAmbar.png"
          },
          {
            "name": "GrafiteAzul",
            "ios": "./assets/icons/GrafiteAzul.png"
          },
          {
            "name": "GrafiteMenta",
            "ios": "./assets/icons/GrafiteMenta.png"
          },
          {
            "name": "GrafiteLima",
            "ios": "./assets/icons/GrafiteLima.png"
          },
          {
            "name": "GrafiteVerde",
            "ios": "./assets/icons/GrafiteVerde.png"
          },
          {
            "name": "CorCarmim",
            "ios": "./assets/icons/CorCarmim.png"
          },
          {
            "name": "CorAmbar",
            "ios": "./assets/icons/CorAmbar.png"
          },
          {
            "name": "CorAzul",
            "ios": "./assets/icons/CorAzul.png"
          },
          {
            "name": "CorMenta",
            "ios": "./assets/icons/CorMenta.png"
          },
          {
            "name": "CorLima",
            "ios": "./assets/icons/CorLima.png"
          },
          {
            "name": "CorVerde",
            "ios": "./assets/icons/CorVerde.png"
          },
          {
            "name": "ClaroCarmim",
            "ios": "./assets/icons/ClaroCarmim.png"
          },
          {
            "name": "ClaroAmbar",
            "ios": "./assets/icons/ClaroAmbar.png"
          },
          {
            "name": "ClaroAzul",
            "ios": "./assets/icons/ClaroAzul.png"
          },
          {
            "name": "ClaroMenta",
            "ios": "./assets/icons/ClaroMenta.png"
          },
          {
            "name": "ClaroLima",
            "ios": "./assets/icons/ClaroLima.png"
          },
          {
            "name": "ClaroVerde",
            "ios": "./assets/icons/ClaroVerde.png"
          },
          {
            "name": "ContornoCarmim",
            "ios": "./assets/icons/ContornoCarmim.png"
          },
          {
            "name": "ContornoAmbar",
            "ios": "./assets/icons/ContornoAmbar.png"
          },
          {
            "name": "ContornoAzul",
            "ios": "./assets/icons/ContornoAzul.png"
          },
          {
            "name": "ContornoMenta",
            "ios": "./assets/icons/ContornoMenta.png"
          },
          {
            "name": "ContornoLima",
            "ios": "./assets/icons/ContornoLima.png"
          },
          {
            "name": "ContornoVerde",
            "ios": "./assets/icons/ContornoVerde.png"
          },
          {
            "name": "Mono",
            "ios": "./assets/icons/Mono.png"
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    }
  }
}
